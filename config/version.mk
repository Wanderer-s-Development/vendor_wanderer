# WandererOS 1.0 Version Configuration
WANDERER_VERSION_MAJOR := 1
WANDERER_VERSION_MINOR := 0
WANDERER_BUILD_TYPE ?= UNOFFICIAL

WANDERER_VERSION := $(WANDERER_VERSION_MAJOR).$(WANDERER_VERSION_MINOR)
WANDERER_DEVICE := $(or $(PRODUCT_DEVICE),$(TARGET_DEVICE),breeze)

ifeq ($(WANDERER_BUILD_TYPE), OFFICIAL)
    WANDERER_DISPLAY_VERSION := WandererOS-$(WANDERER_VERSION)-Official-$(WANDERER_DEVICE)
else
    WANDERER_DISPLAY_VERSION := WandererOS-$(WANDERER_VERSION)-$(WANDERER_BUILD_TYPE)-$(WANDERER_DEVICE)
endif

WANDERER_DATE := $(shell date +%Y%m%d)
WANDERER_PACKAGE := $(WANDERER_DISPLAY_VERSION)-$(WANDERER_DATE).zip
LINEAGE_VERSION := $(WANDERER_DISPLAY_VERSION)-$(WANDERER_DATE)

PRODUCT_SYSTEM_PROPERTIES += \
    ro.wanderer.version=$(WANDERER_VERSION) \
    ro.wanderer.build.version=$(WANDERER_DISPLAY_VERSION) \
    ro.wanderer.build.type=$(WANDERER_BUILD_TYPE) \
    ro.wanderer.device=$(WANDERER_DEVICE) \
    ro.modversion=$(WANDERER_DISPLAY_VERSION)
